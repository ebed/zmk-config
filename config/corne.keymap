#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/led/led.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/backlight.h>
#define ZMK_POINTING_DEFAULT_MOVE_VAL 2500  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // default: 10
#include <dt-bindings/zmk/pointing.h>

/ {
    /* ------------------------------------------------------------------ */
    /* Combos                                                               */
    /*   J+L (pos 6+7) → ESC  — accesible sin mover manos del home row    */
    /* ------------------------------------------------------------------ */
    combos {
        compatible = "zmk,combos";
        combo_esc {
            timeout-ms = <50>;
            key-positions = <6 7>;
            bindings = <&kp ESC>;
        };
    };

    behaviors {
        /* Home Row Mods — izquierda: hold solo al presionar mano derecha --- */
        hml: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <400>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <200>;
            flavor = "balanced";
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        /* Home Row Mods — derecha: hold solo al presionar mano izquierda -- */
        hmr: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <400>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <200>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        /* macOS — Screenshots ------------------------------------------- */
        mac_ss_area: mac_screenshot_area {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LGUI>
                , <&macro_press &kp LSHFT>
                , <&macro_tap &kp N4>
                , <&macro_release &kp LSHFT>
                , <&macro_release &kp LGUI>
                ;
        };
        mac_ss_full: mac_screenshot_full {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LGUI>
                , <&macro_press &kp LSHFT>
                , <&macro_tap &kp N3>
                , <&macro_release &kp LSHFT>
                , <&macro_release &kp LGUI>
                ;
        };
        mac_ss_tool: mac_screenshot_toolbar {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LGUI>
                , <&macro_press &kp LSHFT>
                , <&macro_tap &kp N5>
                , <&macro_release &kp LSHFT>
                , <&macro_release &kp LGUI>
                ;
        };
        /* ⌘+Ctrl+Shift+4 = selección de área → copia al portapapeles (no guarda archivo) */
        mac_ss_clip: mac_screenshot_area_clipboard {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_press &kp LGUI>
                , <&macro_press &kp LSHFT>
                , <&macro_tap &kp N4>
                , <&macro_release &kp LSHFT>
                , <&macro_release &kp LGUI>
                , <&macro_release &kp LCTRL>
                ;
        };

        /* macOS — Escritorios / Mission Control -------------------------- */
        mac_desk_l: mac_desktop_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp LEFT>
                , <&macro_release &kp LCTRL>
                ;
        };
        mac_desk_r: mac_desktop_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp RIGHT>
                , <&macro_release &kp LCTRL>
                ;
        };
        mac_mission: mac_mission_control {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp UP>
                , <&macro_release &kp LCTRL>
                ;
        };
        mac_expose: mac_app_expose {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp DOWN>
                , <&macro_release &kp LCTRL>
                ;
        };

        /* tmux — prefix = Ctrl+B ---------------------------------------- */
        tmux_new: tmux_new_window {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp B>
                , <&macro_release &kp LCTRL>
                , <&macro_tap &kp C>
                ;
        };
        tmux_sph: tmux_split_horizontal {
            /* Ctrl+B, % → split vertical (paneles lado a lado) */
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp B>
                , <&macro_release &kp LCTRL>
                , <&macro_press &kp LSHFT>
                , <&macro_tap &kp N5>
                , <&macro_release &kp LSHFT>
                ;
        };
        tmux_spv: tmux_split_vertical {
            /* Ctrl+B, " → split horizontal (paneles apilados) */
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp B>
                , <&macro_release &kp LCTRL>
                , <&macro_press &kp LSHFT>
                , <&macro_tap &kp SQT>
                , <&macro_release &kp LSHFT>
                ;
        };
        tmux_det: tmux_detach {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp B>
                , <&macro_release &kp LCTRL>
                , <&macro_tap &kp D>
                ;
        };
        tmux_zoom: tmux_zoom_pane {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp B>
                , <&macro_release &kp LCTRL>
                , <&macro_tap &kp Z>
                ;
        };
    };

    keymap {
        compatible = "zmk,keymap";

/* ### Layer 0 — Base (Colemak-DH + HRM)
 * &gresc = tap→ESC / shift→~    combo J+L → ESC alternativo
 * RALT = tap→RALT / hold→Layer 5 (Mac)
 * ,----------------------------------.                ,----------------------------------.
 * |gresc|  Q  |  W  |  F  |  P  |  B |                |  J  |  L  |  U  |  Y  |  ;  |BSPC|
 * |-----+-----+-----+-----+-----+----|                |-----+-----+-----+-----+-----+----|
 * | TAB |GUI/A|ALT/R|CTL/S|SHF/T|  G |                |  M  |SHF/N|CTL/E|ALT/I|GUI/O| '  |
 * |-----+-----+-----+-----+-----+----|                |-----+-----+-----+-----+-----+----|
 * |CTRL |  Z  |  X  |  C  |  D  |  V |                |  K  |  H  |  ,  |  .  |  /  |RET |
 * `-------------------------------'                    `-------------------------------'
 *         |CPSW | GUI |SPACE|                              | MO2 | MO1 |lt5/RALT|
 *         `-------------------'                            `-------------------'
 */
        layer_0 {
            display-name = "Base";
            bindings = <
                &gresc     &kp Q       &kp W       &kp F        &kp P        &kp B          &kp J    &kp L        &kp U        &kp Y       &kp SEMI    &kp BSPC
                &kp TAB    &hml LGUI A  &hml LALT R  &hml LCTRL S  &hml LSHFT T  &kp G          &kp M    &hmr RSHFT N  &hmr RCTRL E  &hmr RALT I  &hmr RGUI O  &kp SQT
                &kp LCTRL  &kp Z       &kp X       &kp C        &kp D        &kp V          &kp K    &kp H        &kp COMMA    &kp DOT     &kp SLASH   &kp RET
                                       &caps_word  &kp LGUI     &kp SPACE                   &mo 2    &mo 1        &lt 5 RALT
            >;
        };

/* ### Layer 1 — Sym  (hold MO1)
 * Números row 0 / Símbolos directos rows 1-2 (sin Shift)
 * SK (sticky shift) abajo del TAB — mismo dedo, fila inferior
 * ,-----------------------------------.                ,----------------------------------.
 * |     |  1  |  2  |  3  |  4  |  5  |                |  6  |  7  |  8  |  9  |  0  |DEL |
 * |-----+-----+-----+-----+-----+-----|                |-----+-----+-----+-----+-----+----|
 * | TAB |  !  |  @  |  #  |  $  |  %  |                |  -  |  =  |  ^  |  |  |  \  | `  |
 * |-----+-----+-----+-----+-----+-----|                |-----+-----+-----+-----+-----+----|
 * | SK  |  &  |  *  |  (  |  )  |  _  |                |  [  |  ]  |  {  |  }  |  +  |RET |
 * `------------------------------------'                `-------------------------------'
 *         |CPSW | GUI |SPACE|                              | MO3 |     |RALT|
 *         `-------------------'                            `-------------------'
 */
        layer_1 {
            display-name = "Sym";
            bindings = <
                &none      &kp N1    &kp N2   &kp N3   &kp N4   &kp N5      &kp N6    &kp N7    &kp N8    &kp N9   &kp N0    &kp DEL
                &kp TAB    &kp EXCL  &kp AT   &kp HASH &kp DLLR &kp PRCNT   &kp MINUS &kp EQUAL &kp CARET &kp PIPE &kp BSLH  &kp GRAVE
                &sk LSHFT  &kp AMPS  &kp STAR &kp LPAR &kp RPAR &kp UNDER   &kp LBKT  &kp RBKT  &kp LBRC  &kp RBRC &kp PLUS  &kp RET
                                      &trans   &kp LGUI &kp SPACE             &mo 3     &none     &trans
            >;
        };

/* ### Layer 2 — Nav  (hold MO2)
 * Mouse izquierda, flechas + nav derecha
 */
        layer_2 {
            display-name = "Nav";
            bindings = <
                &msc SCRL_UP   &none            &mmv MOVE_UP   &none            &mkp LCLK  &none    &none    &none    &kp UP     &none      &none     &kp BSPC
                &msc SCRL_DOWN &mmv MOVE_LEFT   &mmv MOVE_DOWN &mmv MOVE_RIGHT  &mkp MCLK  &none    &none    &kp LEFT &kp DOWN   &kp RIGHT  &kp HOME  &kp PG_UP
                &msc SCRL_LEFT &msc SCRL_RIGHT  &none          &none            &mkp RCLK  &none    &none    &none    &none      &none      &kp END   &kp PG_DN
                                                &trans         &kp LGUI         &kp SPACE            &none    &mo 4    &trans
            >;
        };

/* ### Layer 3 — Sys  (MO1 + MO3)
 * Bluetooth, RGB, Backlight, Bootloader, Media, Lock
 * ,----------------------------------.                ,----------------------------------.
 * |BTCLR|PRV  |PLAY |NXT  | BLE  |USB |                |     |     |     |     |BL-TG|RGB-T|
 * |-----+-----+-----+-----+------+---|                |-----+-----+-----+-----+-----+-----|
 * |SOFF | BT0 | BT1 | BT2 |VOL- |VOL+|                |RGB+ |     | BL- | BL+ |RGB- |RGB++|
 * |-----+-----+-----+-----+------+---|                |-----+-----+-----+-----+-----+-----|
 * |BOOT | BT3 | BT4 | BT5 |MUTE |LCK |                |🟢   | 🔴  | 🔵  | 🟡  |     |     |
 * `-------------------------------'                    `-------------------------------'
 *         | GUI |     |SPACE|                              | RET |     |RALT |
 *         `-------------------'                            `-------------------'
 */
        lower_layer {
            display-name = "Sys";
            bindings = <
                &bt BT_CLR  &kp C_PREV   &kp C_PP     &kp C_NEXT    &out OUT_BLE  &out OUT_USB    &none                               &none                            &none                              &none                            &bl BL_TOG       &rgb_ug RGB_TOG
                &soft_off   &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2  &kp C_VOL_DN  &kp C_VOL_UP   &rgb_ug RGB_EFF                     &none                            &bl BL_DEC                         &bl BL_INC                       &rgb_ug RGB_BRD  &rgb_ug RGB_BRI
                &bootloader &bt BT_SEL 3 &bt BT_SEL 4 &bt BT_SEL 5  &kp C_MUTE    &kp LG(LC(Q))  &rgb_ug RGB_COLOR_HSB(128, 100,100) &rgb_ug RGB_COLOR_HSB(0,100,100) &rgb_ug RGB_COLOR_HSB(240,100,100) &rgb_ug RGB_COLOR_HSB(64,100,50) &none            &none
                                         &kp LGUI     &none          &kp SPACE                     &kp RET  &none   &trans
            >;
        };

/* ### Layer 4 — Fn  (MO2 + MO4)
 * F1–F12
 */
        functions_layer {
            display-name = "Fn";
            bindings = <
                &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6   &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12
                &none  &none  &none  &none  &none  &none    &none  &none  &none  &none   &none   &none
                &trans &none  &none  &none  &none  &none    &none  &none  &none  &none   &none   &none
                              &trans &none  &none            &none  &none  &none
            >;
        };

/* ### Layer 5 — Mac  (hold RALT)
 * Izquierda: macOS shortcuts   Derecha: Rectangle win mgmt (fila 1) + tmux (filas 2-3)
 * Rectangle: ⌥⌘← → ↑ ↓ F(max) ⌫(rst) C(ctr)
 * DSK1-5: requiere activar en Ajustes→Teclado→Atajos→Mission Control
 * MW←/→:  requiere activar "Mover ventana al espacio" en los mismos Ajustes
 * ,--------------------------------------------.                ,-------------------------------------------.
 * |DSK1 |DSK2 |DSK3 |DSK4 |DSK5 | HDE  |                |WIN← |WIN→ |WIN↑ |WIN↓ |⌥⌘F  |⌥⌘⌫  |
 * |-----+-----+-----+-----+-----+------|                |-----+-----+-----+-----+-----+-----|
 * | FQ  |SS📋 |SS/4 |SS/3 |SS/5 | MCrl |                |     | CTR |TMX.D|TMX.Z|     |     |
 * |-----+-----+-----+-----+-----+------|                |-----+-----+-----+-----+-----+-----|
 * |     |DSK← |DSK→ |EXP  | MW← | MW→  |                |     |     |TMX.N|TMX.%|TMX."|     |
 * `--------------------------------------------'                `-------------------------------------------'
 *         |     | GUI |SPACE|                              |     |     |[held]|
 *         `-------------------'                            `-------------------'
 */
        macro_layer {
            display-name = "Mac";
            bindings = <
                &kp LC(N1)       &kp LC(N2)   &kp LC(N3)   &kp LC(N4)   &kp LC(N5)       &kp LG(LA(H))    &kp LA(LG(LEFT))  &kp LA(LG(RIGHT))  &kp LA(LG(UP))  &kp LA(LG(DOWN))  &kp LA(LG(F))  &kp LA(LG(BSPC))
                &kp LG(LA(ESC)) &mac_ss_clip  &mac_ss_area &mac_ss_full &mac_ss_tool     &mac_mission     &none             &kp LA(LG(C))      &tmux_det       &tmux_zoom        &none          &none
                &none            &mac_desk_l  &mac_desk_r  &mac_expose  &kp LC(LS(LEFT)) &kp LC(LS(RIGHT)) &none             &none              &tmux_new       &tmux_sph         &tmux_spv      &none
                                              &none        &kp LGUI     &kp SPACE                          &none             &none              &trans
            >;
        };
    };
};


&spi3 {
  compatible = "nordic,nrf-spim";
  status = "okay";

  pinctrl-0 = <&spi3_default>;
  pinctrl-1 = <&spi3_sleep>;
  pinctrl-names = "default", "sleep";

  led_strip: ws2812@0 {
    compatible = "worldsemi,ws2812-spi";

    /* SPI */
    reg = <0>; /* ignored, but necessary for SPI bindings */
    spi-max-frequency = <4000000>;

    /* WS2812 */
    chain-length = <27>; /* number of LEDs */
    spi-one-frame = <0x70>;
    spi-zero-frame = <0x40>;
    color-mapping = <LED_COLOR_ID_GREEN
                          LED_COLOR_ID_RED
                          LED_COLOR_ID_BLUE>;
  };
};
