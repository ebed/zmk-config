#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/led/led.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/backlight.h>
#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // default: 10
#include <dt-bindings/zmk/pointing.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
    /* ------------------------------------------------------------------ */
    /* Input processors                                                     */
    /* ------------------------------------------------------------------ */
    input_processors {
        zip_xy_scaler: zip_xy_scaler_2x {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_X INPUT_REL_Y>;
            track-remainders;
        };
    };

    /* ------------------------------------------------------------------ */
    /* Combos                                                               */
    /*   J+L (pos 6+7) → ESC  — accesible sin mover manos del home row    */
    /* ------------------------------------------------------------------ */
    combos {
        compatible = "zmk,combos";
        combo_esc {
            timeout-ms = <50>;
            key-positions = <6 7>;
            bindings = <&kp ESC>;
        };
        combo_sys {
            timeout-ms = <50>;
            key-positions = <38 41>;
            bindings = <&mo 3>;
        };
    };

    behaviors {
        /* Home Row Mods — izquierda: hold solo al presionar mano derecha --- */
        hml: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <400>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <200>;
            flavor = "balanced";
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        /* Left outer thumb: tap→CapsWord / hold→Lang (L6) -------------------- */
        lang_cw: lang_caps_word {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&caps_word>;
        };

        /* Home Row Mods — derecha: hold solo al presionar mano izquierda -- */
        hmr: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <400>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <200>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        /* tap = número / hold = símbolo Shift+número ----------------------- */
        num_sym: num_sym {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        /* macOS — Screenshots ------------------------------------------- */
        mac_ss_area: mac_screenshot_area {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LGUI>
                , <&macro_press &kp LSHFT>
                , <&macro_tap &kp N4>
                , <&macro_release &kp LSHFT>
                , <&macro_release &kp LGUI>
                ;
        };
        /* ⌘+Ctrl+Shift+4 = selección de área → copia al portapapeles (no guarda archivo) */
        mac_ss_clip: mac_screenshot_area_clipboard {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_press &kp LGUI>
                , <&macro_press &kp LSHFT>
                , <&macro_tap &kp N4>
                , <&macro_release &kp LSHFT>
                , <&macro_release &kp LGUI>
                , <&macro_release &kp LCTRL>
                ;
        };

        /* macOS — Escritorios / Mission Control -------------------------- */
        mac_desk_l: mac_desktop_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp LEFT>
                , <&macro_release &kp LCTRL>
                ;
        };
        mac_desk_r: mac_desktop_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp RIGHT>
                , <&macro_release &kp LCTRL>
                ;
        };
        mac_mission: mac_mission_control {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp UP>
                , <&macro_release &kp LCTRL>
                ;
        };
        mac_expose: mac_app_expose {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp DOWN>
                , <&macro_release &kp LCTRL>
                ;
        };

        /* tmux — prefix = Ctrl+B ---------------------------------------- */
        tmux_new: tmux_new_window {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp B>
                , <&macro_release &kp LCTRL>
                , <&macro_tap &kp C>
                ;
        };
        tmux_sph: tmux_split_horizontal {
            /* Ctrl+B, % → split vertical (paneles lado a lado) */
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp B>
                , <&macro_release &kp LCTRL>
                , <&macro_press &kp LSHFT>
                , <&macro_tap &kp N5>
                , <&macro_release &kp LSHFT>
                ;
        };
        tmux_spv: tmux_split_vertical {
            /* Ctrl+B, " → split horizontal (paneles apilados) */
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp B>
                , <&macro_release &kp LCTRL>
                , <&macro_press &kp LSHFT>
                , <&macro_tap &kp SQT>
                , <&macro_release &kp LSHFT>
                ;
        };
        tmux_det: tmux_detach {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp B>
                , <&macro_release &kp LCTRL>
                , <&macro_tap &kp D>
                ;
        };
        tmux_zoom: tmux_zoom_pane {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp B>
                , <&macro_release &kp LCTRL>
                , <&macro_tap &kp Z>
                ;
        };
        lang_a: lang_a_acute {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(E)>, <&kp A>;
        };
        lang_e: lang_e_acute {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(E)>, <&kp E>;
        };
        lang_i: lang_i_acute {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(E)>, <&kp I>;
        };
        lang_o: lang_o_acute {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(E)>, <&kp O>;
        };
        lang_u: lang_u_acute {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(E)>, <&kp U>;
        };
        lang_n: lang_n_tilde {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(N)>, <&kp N>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

/* ### Layer 0 — Base (Colemak-DH + HRM)
 * &gresc = tap→ESC / shift→~    combo J+L → ESC alternativo
 * BSPC: tap→⌫ / hold→Fn 4.  Bottom-left: tap→CapsWord / hold→⌘ GUI.
 * Left thumb: CW/L6 (tap CapsWord·hold Lang) · MO7 (hold Apps).
 * Right: inner=tap RET/hold Mac5 · middle=MO1 · outer=MO2.   Combo SPC+MO2 → Sys 3.
 * ,----------------------------------.                ,----------------------------------.
 * |gresc|  Q  |  W  |  F  |  P  |  B |                |  J  |  L  |  U  |  Y  |  ;  |BSP4|
 * |-----+-----+-----+-----+-----+----|                |-----+-----+-----+-----+-----+----|
 * | TAB |GUI/A|ALT/R|CTL/S|SHF/T|  G |                |  M  |SHF/N|CTL/E|ALT/I|GUI/O| '  |
 * |-----+-----+-----+-----+-----+----|                |-----+-----+-----+-----+-----+----|
 * |REPT |  Z  |  X  |  C  |  D  |  V |                |  K  |  H  |  ,  |  .  |  /  |MO3 |
 * `-------------------------------'                    `-------------------------------'
 *         |CW/L6| MO7 |SPACE|                          |RET/5| MO1 | MO2 |
 *         `---------------------'                       `-------------------'
 */
        layer_0 {
            display-name = "Base";
            bindings = <
                &gresc          &kp Q       &kp W       &kp F        &kp P        &kp B          &kp J    &kp L        &kp U        &kp Y       &kp SEMI    &lt 4 BSPC
                &kp TAB         &hml LGUI A  &hml LALT R  &hml LCTRL S  &hml LSHFT T  &kp G          &kp M    &hmr RSHFT N  &hmr RCTRL E  &hmr RALT I  &hmr RGUI O  &kp SQT
                &key_repeat     &kp Z       &kp X       &kp C        &kp D        &kp V          &kp K    &kp H        &kp COMMA    &kp DOT     &kp SLASH   &tog 8
                                            &lang_cw 6 0  &mo 7        &kp SPACE                  &lt 5 RET  &mo 1  &mo 2
            >;
        };

/* ### Layer 1 — Sym  (hold MO1)
 * Números row 0: tap=número, hold=símbolo (1/! 2/@ 3/# 4/$ 5/% 6/^ 7/& 8/* 9/( 0/))
 * Home row mantiene acceso rápido a símbolos comunes (ruta ergonómica alternativa)
 * SK (sticky shift) abajo del TAB — mismo dedo, fila inferior
 * ,------------------------------------.                ,----------------------------------.
 * |REPT |1/!  |2/@  |3/#  |4/$  |5/%   |                |6/^  |7/&  |8/*  |9/(  |0/)  |DEL |
 * |-----+-----+-----+-----+-----+------|                |-----+-----+-----+-----+-----+----|
 * | TAB |  !  |  @  |  #  |  $  |  %   |                |  -  |  =  |  ^  |  |  |  \  | `  |
 * |-----+-----+-----+-----+-----+------|                |-----+-----+-----+-----+-----+----|
 * | SK  |  &  |  *  |  (  |  )  |  _   |                |  [  |  ]  |  {  |  }  |  +  |RET |
 * `-------------------------------------'                `-------------------------------'
 *         |CW/L6 | MO7  |SPACE|                             | MO3 |     |TOG1|
 *         `-------------------'                            `-------------------'
 */
        layer_1 {
            display-name = "Sym";
            bindings = <
                &key_repeat &num_sym EXCL N1  &num_sym AT N2   &num_sym HASH N3  &num_sym DLLR N4  &num_sym PRCNT N5    &num_sym CARET N6  &num_sym AMPS N7  &num_sym STAR N8  &num_sym LPAR N9  &num_sym RPAR N0  &kp DEL
                &kp TAB    &kp EXCL  &kp AT   &kp HASH &kp DLLR &kp PRCNT   &kp MINUS &kp EQUAL &kp UNDER &kp PIPE &kp BSLH  &kp GRAVE
                &sk LSHFT  &kp AMPS  &kp STAR &kp LPAR &kp RPAR &kp CARET   &kp LBKT  &kp RBKT  &kp LBRC  &kp RBRC &kp PLUS  &kp RET
                                      &trans   &trans   &kp SPACE             &mo 3     &trans    &tog 1
            >;
        };

/* ### Layer 2 — Nav  (hold MO2)
 * Edición texto izquierda / flechas + nav + word-jump + selección derecha
 * ,------------------------------------.                ,--------------------------------------------.
 * |     |     |     |     |     | DEL  |                |⇧HOME|WJ←  |  ↑  |WJ→  |⇧END |BSPC |
 * |-----+-----+-----+-----+-----+------|                |-----+-----+-----+-----+-----+-----|
 * |     |     | ⌘←  | ⌘Z  | ⌘⇧Z | ⌘→   |                |     | ←   |  ↓  |  →  |HOME |PGUP |
 * |-----+-----+-----+-----+-----+------|                |-----+-----+-----+-----+-----+-----|
 * |     |     | ⌘X  | ⌘C  | ⌘V  |      |                |SEL↑ |SEL← |SEL↓ |SEL→ |END  |PGDN |
 * `-------------------------------------'               `--------------------------------------------'
 *         |     | MO4 |     |                              |MO4  |     |     |
 *         `-------------------'                            `-------------------'
 */
        layer_2 {
            display-name = "Nav";
            bindings = <
                &none  &none  &none          &none          &none           &kp DEL          &kp LS(HOME)  &kp LA(LEFT)  &kp UP       &kp LA(RIGHT)  &kp LS(END)  &kp BSPC
                &none  &none  &kp LG(LEFT)   &kp LG(Z)      &kp LG(LS(Z))  &kp LG(RIGHT)    &none         &kp LEFT      &kp DOWN     &kp RIGHT      &kp HOME     &kp PG_UP
                &none  &none  &kp LG(X)      &kp LG(C)      &kp LG(V)      &none            &kp LS(UP)    &kp LS(LEFT)  &kp LS(DOWN) &kp LS(RIGHT)  &kp END      &kp PG_DN
                               &trans         &mo 4          &trans                           &mo 4    &trans   &trans
            >;
        };

/* ### Layer 3 — Sys  (MO1 + MO3)
 * Bluetooth, RGB, Backlight, Bootloader, Media, Lock
 * ,----------------------------------.                ,----------------------------------.
 * |BTCLR|PRV  |PLAY |NXT  | BLE  |USB |                |BRI- |BRI+ |     |     |BL-TG|RGB-T|
 * |-----+-----+-----+-----+------+---|                |-----+-----+-----+-----+-----+-----|
 * |SOFF | BT0 | BT1 | BT2 |VOL- |VOL+|                |RGB+ |     | BL- | BL+ |RGB- |RGB++|
 * |-----+-----+-----+-----+------+---|                |-----+-----+-----+-----+-----+-----|
 * |BOOT | BT3 | BT4 | BT5 |MUTE |LCK |                |🟢   | 🔴  | 🔵  | 🟡  |     |     |
 * `-------------------------------'                    `-------------------------------'
 *         | GUI |     |SPACE|                              | RET |     |RALT |
 *         `-------------------'                            `-------------------'
 */
        lower_layer {
            display-name = "Sys";
            bindings = <
                &bt BT_CLR  &kp C_PREV   &kp C_PP     &kp C_NEXT    &out OUT_BLE  &out OUT_USB    &kp C_BRI_DN                        &kp C_BRI_UP                     &none                              &none                            &bl BL_TOG       &rgb_ug RGB_TOG
                &none       &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2  &kp C_VOL_DN  &kp C_VOL_UP   &rgb_ug RGB_EFF                     &none                            &bl BL_DEC                         &bl BL_INC                       &rgb_ug RGB_BRD  &rgb_ug RGB_BRI
                &none       &bt BT_SEL 3 &bt BT_SEL 4 &none         &kp C_MUTE    &kp LG(LC(Q))  &rgb_ug RGB_COLOR_HSB(128, 100,100) &rgb_ug RGB_COLOR_HSB(0,100,100) &rgb_ug RGB_COLOR_HSB(240,100,100) &rgb_ug RGB_COLOR_HSB(64,100,50) &soft_off        &bootloader
                                         &kp LGUI     &none          &kp SPACE                     &kp RET  &none   &trans
            >;
        };

/* ### Layer 4 — Fn  (MO2 + MO4)
 * F1–F12
 */
        functions_layer {
            display-name = "Fn";
            bindings = <
                &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6   &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12
                &none  &none  &none  &none  &none  &none    &none  &none  &none  &none   &none   &none
                &trans &none  &none  &none  &none  &none    &none  &none  &none  &none   &none   &none
                              &trans &none  &none            &none  &none  &none
            >;
        };

/* ### Layer 5 — Mac  (hold RALT)
 * Izquierda: macOS shortcuts   Derecha: Rectangle win mgmt (fila 1) + tmux (filas 2-3)
 * Rectangle: ⌥⌘← → ↑ ↓ F(max) ⌫(rst) C(ctr)
 * DSK1-5: requiere activar en Ajustes→Teclado→Atajos→Mission Control
 * MW←/→:  requiere activar "Mover ventana al espacio" en los mismos Ajustes
 * ,--------------------------------------------.                ,-------------------------------------------.
 * |DSK1 |DSK2 |DSK3 |DSK4 |DSK5 | HDE  |                |WIN← |WIN→ |WIN↑ |WIN↓ |⌥⌘F  |⌥⌘⌫  |
 * |-----+-----+-----+-----+-----+------|                |-----+-----+-----+-----+-----+-----|
 * | FQ  |SS📋 |SS/4 | UND | RED | MCrl |                | BCK | CTR |TMX.D|TMX.Z| FWD |     |
 * |-----+-----+-----+-----+-----+------|                |-----+-----+-----+-----+-----+-----|
 * |     |DSK← |DSK→ |EXP  | MW← | MW→  |                |DSP← |DSP→ |TMX.N|TMX.%|TMX."|     |
 * `--------------------------------------------'                `-------------------------------------------'
 *         |     | GUI |SPACE|                              |     |     |[held]|
 *         `-------------------'                            `-------------------'
 */
        macro_layer {
            display-name = "Mac";
            bindings = <
                &kp LC(N1)       &kp LC(N2)   &kp LC(N3)   &kp LC(N4)   &kp LC(N5)       &kp LG(LA(H))    &kp LA(LG(LEFT))  &kp LA(LG(RIGHT))  &kp LA(LG(UP))  &kp LA(LG(DOWN))  &kp LA(LG(F))  &kp LA(LG(BSPC))
                &kp LG(LA(ESC)) &mac_ss_clip  &mac_ss_area &kp LG(Z)   &kp LG(LS(Z))   &mac_mission     &kp LG(LBKT)      &kp LA(LG(C))      &tmux_det       &tmux_zoom        &kp LG(RBKT)   &none
                &none            &mac_desk_l  &mac_desk_r  &mac_expose  &kp LC(LS(LEFT)) &kp LC(LS(RIGHT)) &kp LA(LG(LS(LEFT))) &kp LA(LG(LS(RIGHT))) &tmux_new    &tmux_sph         &tmux_spv      &none
                                              &none        &kp LGUI     &kp SPACE                          &none             &none              &trans
            >;
        };

/* ### Layer 6 — Lang (hold CPSW)
 * Español: dead keys + ¿ + ¡ en el home row izquierdo.
 * Todo lo demás transparente — las teclas normales siguen funcionando.
 * ´ = ⌥E dead acute → suelta CPSW → escribe vocal → á/é/í/ó/ú
 * ~ = ⌥N dead tilde → suelta CPSW → escribe N → ñ
 * ¨ = ⌥U dead umlaut → suelta CPSW → escribe U → ü
 * ,-----------------------------------.                ,----------------------------------.
 * |     |     |     |     |     |     |                |     |     |     |     |     |    |
 * |-----+-----+-----+-----+-----+-----|                |-----+-----+-----+-----+-----+----|
 * |     |  ´  |  ~  |  ¨  |  ¿  |  ¡  |                |     |     |     |     |     |    |
 * |-----+-----+-----+-----+-----+-----|                |-----+-----+-----+-----+-----+----|
 * |     |     |     |     |     |     |                |     |     |     |     |     |    |
 * `------------------------------------'                `-------------------------------'
 *         |[held]|     |     |                              |     |     |     |
 *         `---------------------'                           `-------------------'
 */
        lang_layer {
            display-name = "Lang";
            bindings = <
                &trans  &trans      &trans      &trans      &trans              &trans        &trans &trans &lang_u &trans &trans &trans
                &trans  &kp LA(E)   &kp LA(N)   &kp LA(U)   &kp LA(LS(FSLH))  &kp LA(N1)    &lang_a &lang_n &lang_e &lang_i &lang_o &trans
                &trans  &trans      &trans      &trans      &trans              &trans        &trans &trans &trans &trans &trans &trans
                                    &trans      &trans      &trans                            &trans &trans &trans
            >;
        };

/* ### Layer 7 — Apps  (hold CTL/L7 / izq-medio)
 * Activación: hold CTL/L7 (izq-medio) desde cualquier layer — single key
 * Izq top row : WezTerm (Q=new-tab W=close F=split-V P=split-H) — B vacío
 * Izq home row: Zoom (A=mute R=video S=share T=leave) — G vacío
 * Izq bot row : Claude (Z=new) + Slack (X=mentions C=code D=jump)
 * Der top row : Hammerspoon focus-or-launch (J=Wez L=Slk U=Zoom Y=Chrome ;=cycle-win)
 * ,------------------------------------.                ,--------------------------------------------.
 * |     |WTAB |WCLS |WSPL-V|WSPL-H|    |                | WEZ | SLK | ZOM | CHR |CYCL |BSPC |
 * |-----+-----+-----+------+------+----|                |-----+-----+-----+-----+-----+-----|
 * |     |ZMUT |ZVID |ZSHR  |ZLVE  |    |                |HELP | ←   |  ↓  |  →  |HOME |PGUP |
 * |-----+-----+-----+------+------+----|                |-----+-----+-----+-----+-----+-----|
 * |     |CLNEW|SMEN |SCOD  |SJMP  |    |                |     |SEL← |SEL↓ |SEL→ |END  |PGDN |
 * `------------------------------------'                `--------------------------------------------'
 *         |CW/L6|[held]|     |                              |RET/5| MO1 | MO2 |
 *         `-------------------'                             `-------------------'
 */
        apps_layer {
            display-name = "Apps";
            bindings = <
                &none  &kp LG(T)      &kp LG(W)      &kp LG(D)      &kp LG(LS(D))  &none            &kp LA(LG(LS(W))) &kp LA(LG(LS(S))) &kp LA(LG(LS(Z))) &kp LA(LG(LS(C))) &kp LG(GRAVE) &trans
                &none  &kp LG(LS(A))  &kp LG(LS(V))  &kp LG(LS(S))  &kp LG(LS(H))  &none            &kp LA(LG(LS(H))) &trans            &trans            &trans            &trans &trans
                &none  &kp LG(N)      &kp LG(LS(M))  &kp LG(LS(C))  &kp LG(K)      &none            &trans            &trans            &trans            &trans            &trans &trans
                                       &trans          &trans          &trans                           &trans &trans &trans
            >;
        };

/* ### Layer 8 — Mouse  (tog 8 desde meñique der inferior en L0)
 * Toggle: tap para entrar / tap para salir (TOG8 en pulgar izq o meñique der inferior).
 * Izquierda: movimiento ESDF-like + scroll col externa.
 * Derecha: clics columna inner-index (J=LCLK M=MCLK K=RCLK).
 * Pulgar der medio: MO9 (turbo — mantener para velocidad 2×).
 * ,------------------------------------.                ,----------------------------------.
 * |SCRL↑|     |     |  M↑ |     |     |                |LCLK |     |     |     |     |     |
 * |-----+-----+-----+-----+-----+-----|                |-----+-----+-----+-----+-----+-----|
 * |SCRL↓|     | M←  | M↓  | M→  |     |                |MCLK |     |     |     |     |     |
 * |-----+-----+-----+-----+-----+-----|                |-----+-----+-----+-----+-----+-----|
 * |SCRL←|SCRL→|     |     |     |     |                |RCLK |     |     |     |     |EXIT |
 * `-------------------------------------'               `----------------------------------'
 *         | EXIT|     |     |                              |     |TURBO|     |
 *         `-------------------'                            `-------------------'
 */
        mouse_layer {
            display-name = "Mouse";
            bindings = <
                &msc SCRL_UP    &none            &none  &mmv MOVE_UP    &none  &none    &mkp LCLK  &none  &none  &none  &none  &none
                &msc SCRL_DOWN  &none            &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &none    &mkp MCLK  &none  &none  &none  &none  &none
                &msc SCRL_LEFT  &msc SCRL_RIGHT  &none  &none           &none  &none    &mkp RCLK  &none  &none  &none  &none  &tog 8
                                &tog 8           &none  &none                            &none  &mo 9  &none
            >;
        };

/* ### Layer 9 — Mouse Turbo  (MO9 desde L8 pulgar der medio)
 * Idéntica a L8 pero con mmv_fast (3000 vs 1500 default).
 * Momentánea: solo activa mientras se mantiene el pulgar.
 */
        mouse_turbo_layer {
            display-name = "Turbo";
            input-processors = <&zip_xy_scaler 2 1>;
            bindings = <
                &msc SCRL_UP    &none            &none  &mmv MOVE_UP    &none  &none    &mkp LCLK  &none  &none  &none  &none  &none
                &msc SCRL_DOWN  &none            &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &none    &mkp MCLK  &none  &none  &none  &none  &none
                &msc SCRL_LEFT  &msc SCRL_RIGHT  &none  &none           &none  &none    &mkp RCLK  &none  &none  &none  &none  &tog 8
                                &tog 8           &none  &none                            &none  &trans  &none
            >;
        };
    };
};


&spi3 {
  compatible = "nordic,nrf-spim";
  status = "okay";

  pinctrl-0 = <&spi3_default>;
  pinctrl-1 = <&spi3_sleep>;
  pinctrl-names = "default", "sleep";

  led_strip: ws2812@0 {
    compatible = "worldsemi,ws2812-spi";

    /* SPI */
    reg = <0>; /* ignored, but necessary for SPI bindings */
    spi-max-frequency = <4000000>;

    /* WS2812 */
    chain-length = <27>; /* number of LEDs */
    spi-one-frame = <0x70>;
    spi-zero-frame = <0x40>;
    color-mapping = <LED_COLOR_ID_GREEN
                          LED_COLOR_ID_RED
                          LED_COLOR_ID_BLUE>;
  };
};
