#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/led/led.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/backlight.h>
#define ZMK_POINTING_DEFAULT_MOVE_VAL 2500  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // default: 10
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

/* ### Layer 0 (Base — Colemak-DH + Home Row Mods) */
/* ,----------------------------------.                ,----------------------------------. */
/* | ESC |  Q  |  W  |  F  |  P  |  B |                |  J  |  L  |  U  |  Y  |  ;  |BSPC| */
/* |-----+-----+-----+-----+-----+----|                |-----+-----+-----+-----+-----+----| */
/* | TAB |GUI/A|ALT/R|CTL/S|SHF/T|  G |                |  M  |SHF/N|CTL/E|ALT/I|GUI/O| '  | */
/* |-----+-----+-----+-----+-----+----|                |-----+-----+-----+-----+-----+----| */
/* |CTRL |  Z  |  X  |  C  |  D  |  V |                |  K  |  H  |  ,  |  .  |  /  |RET | */
/* `-------------------------------'                    `-------------------------------' */
/*         |CPSW | GUI |SPACE|                              | MO2 | MO1 |RALT| */
/*         `-------------------'                            `-------------------' */
        layer_0 {
            display-name = "Base";
            bindings = <
                &kp ESC    &kp Q       &kp W       &kp F        &kp P        &kp B          &kp J    &kp L        &kp U        &kp Y       &kp SEMI    &kp BSPC
                &kp TAB    &hm LGUI A  &hm LALT R  &hm LCTRL S  &hm LSHFT T  &kp G          &kp M    &hm RSHFT N  &hm RCTRL E  &hm RALT I  &hm RGUI O  &kp SQT
                &kp LCTRL  &kp Z       &kp X       &kp C        &kp D        &kp V          &kp K    &kp H        &kp COMMA    &kp DOT     &kp SLASH   &kp RET
                                       &caps_word  &kp LGUI     &kp SPACE                   &mo 2    &mo 1        &kp RALT
            >;
        };

/* ### Layer 1 (Numbers/Symbols) */
/* ,----------------------------------.                ,----------------------------------. */
/* |NONE |  1  |  2  |  3  |  4  |  5 |                |  6  |  7  |  8  |  9  |  0  |DEL | */
/* |-----+-----+-----+-----+-----+----|                |-----+-----+-----+-----+-----+----| */
/* | TAB |NONE |NONE |NONE |NONE |NONE|                |  -  |  =  |NONE |NONE |  \  | `  | */
/* |-----+-----+-----+-----+-----+----|                |-----+-----+-----+-----+-----+----| */
/* |trns |NONE |NONE |NONE |NONE |NONE|                |  [  |  ]  |NONE |NONE |NONE |RET | */
/* `-------------------------------'                    `-------------------------------' */
/*         |trns | GUI |SPACE|                              | MO3 |NONE |RALT| */
/*         `-------------------'                            `-------------------' */
        layer_1 {
            display-name = "Nums";
            bindings = <
                &none   &kp N1   &kp N2   &kp N3   &kp N4   &kp N5         &kp N6    &kp N7    &kp N8   &kp N9   &kp N0    &kp DEL
                &kp TAB &none    &none    &none    &none    &none          &kp MINUS  &kp EQUAL &none    &none    &kp BSLH  &kp GRAVE
                &trans  &none    &none    &none    &none    &none          &kp LBKT   &kp RBKT  &none    &none    &none     &kp RET
                                 &trans   &kp LGUI &kp SPACE                &mo 3    &none      &kp RALT
            >;
        };

/* ### Layer 2 (Navigation/Mouse) */
/* ,----------------------------------.                ,----------------------------------. */
/* |SCRUP|NONE |MUP  |NONE |LCLK |NONE|                |NONE | UP  |NONE |NONE |NONE |BSPC| */
/* |-----+-----+-----+-----+-----+----|                |-----+-----+-----+-----+-----+----| */
/* |SCRDN|MLFT |MDN  |MRGT |MCLK |NONE|                |LEFT |DOWN |RGHT |HOME |PGUP |NONE| */
/* |-----+-----+-----+-----+-----+----|                |-----+-----+-----+-----+-----+----| */
/* |SCLFT|SCRT |NONE |NONE |RCLK |NONE|                |NONE |NONE |NONE |END  |PGDN |NONE| */
/* `-------------------------------'                    `-------------------------------' */
/*         |trns | GUI |SPACE|                              |NONE | MO4 |RALT| */
/*         `-------------------'                            `-------------------' */
        layer_2 {
            display-name = "Nav";
            bindings = <
                &msc SCRL_UP   &none            &mmv MOVE_UP   &none            &mkp LCLK  &none    &none    &none    &kp UP     &none      &none     &kp BSPC
                &msc SCRL_DOWN &mmv MOVE_LEFT   &mmv MOVE_DOWN &mmv MOVE_RIGHT  &mkp MCLK  &none    &none    &kp LEFT &kp DOWN   &kp RIGHT  &kp HOME  &kp PG_UP
                &msc SCRL_LEFT &msc SCRL_RIGHT  &none          &none            &mkp RCLK  &none    &none    &none    &none      &none      &kp END   &kp PG_DN
                                                &trans         &kp LGUI         &kp SPACE            &none    &mo 4    &kp RALT
            >;
        };

/* ### Layer 3 (Sistema — BT/RGB/Bootloader) */
/* ,----------------------------------.                ,----------------------------------. */
/* |BTCLR|NONE |NONE |NONE |BLE  |USB |                |NONE |NONE |NONE |NONE |BLTG |RGBT| */
/* |-----+-----+-----+-----+-----+----|                |-----+-----+-----+-----+-----+----| */
/* |SOFF | BT0 | BT1 | BT2 |NONE |NONE|                |RGBE |NONE |BLD  |BLI  |RGBD |RGBI| */
/* |-----+-----+-----+-----+-----+----|                |-----+-----+-----+-----+-----+----| */
/* |BOOT | BT3 | BT4 | BT5 |NONE |NONE|                |RGB1 |RGB2 |RGB3 |RGB4 |NONE |NONE| */
/* `-------------------------------'                    `-------------------------------' */
/*         | GUI |NONE |SPACE|                              |RET  |NONE |RALT| */
/*         `-------------------'                            `-------------------' */
        lower_layer {
            display-name = "Sys";
            bindings = <
                &bt BT_CLR  &none        &none        &none         &out OUT_BLE  &out OUT_USB    &none                               &none                            &none                              &none                            &bl BL_TOG       &rgb_ug RGB_TOG
                &soft_off   &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2  &none         &none           &rgb_ug RGB_EFF                     &none                            &bl BL_DEC                         &bl BL_INC                       &rgb_ug RGB_BRD  &rgb_ug RGB_BRI
                &bootloader &bt BT_SEL 3 &bt BT_SEL 4 &bt BT_SEL 5  &none         &none           &rgb_ug RGB_COLOR_HSB(128, 100,100) &rgb_ug RGB_COLOR_HSB(0,100,100) &rgb_ug RGB_COLOR_HSB(240,100,100) &rgb_ug RGB_COLOR_HSB(64,100,50) &none            &none
                                         &kp LGUI     &none          &kp SPACE                     &kp RET  &none   &kp RALT
            >;
        };

/* ### Layer 4 (Funciones) */
/* ,----------------------------------.                ,----------------------------------. */
/* | F1  | F2  | F3  | F4  | F5  | F6 |                | F7  | F8  | F9  | F10 | F11 |F12 | */
/* |-----+-----+-----+-----+-----+----|                |-----+-----+-----+-----+-----+----| */
/* |NONE |NONE |NONE |NONE |NONE |NONE|                |NONE |NONE |NONE |NONE |NONE |NONE| */
/* |-----+-----+-----+-----+-----+----|                |-----+-----+-----+-----+-----+----| */
/* |trns |NONE |NONE |NONE |NONE |NONE|                |NONE |NONE |NONE |NONE |NONE |NONE| */
/* `-------------------------------'                    `-------------------------------' */
/*         |trns |NONE |NONE |                              |NONE |NONE |NONE| */
/*         `-------------------'                            `-------------------' */
        functions_layer {
            display-name = "Fn";
            bindings = <
                &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6   &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12
                &none  &none  &none  &none  &none  &none    &none  &none  &none  &none   &none   &none
                &trans &none  &none  &none  &none  &none    &none  &none  &none  &none   &none   &none
                              &trans &none  &none            &none  &none  &none
            >;
        };
    };
};


&spi3 {
  compatible = "nordic,nrf-spim";
  status = "okay";

  pinctrl-0 = <&spi3_default>;
  pinctrl-1 = <&spi3_sleep>;
  pinctrl-names = "default", "sleep";

  led_strip: ws2812@0 {
    compatible = "worldsemi,ws2812-spi";

    /* SPI */
    reg = <0>; /* ignored, but necessary for SPI bindings */
    spi-max-frequency = <4000000>;

    /* WS2812 */
    chain-length = <27>; /* number of LEDs */
    spi-one-frame = <0x70>;
    spi-zero-frame = <0x40>;
    color-mapping = <LED_COLOR_ID_GREEN
                          LED_COLOR_ID_RED
                          LED_COLOR_ID_BLUE>;
  };
};
