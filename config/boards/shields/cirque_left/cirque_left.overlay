/*
 * Lado central (izquierda): recibe los eventos del trackpad Cirque del
 * periférico vía input-split y los procesa con el listener. Nodos propios
 * del shield (los shields se procesan antes que el keymap).
 */

#include <input/processors.dtsi>

/ {
    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        glidepoint_split: glidepoint_split@0 {
            compatible = "zmk,input-split";
            reg = <0>;
        };
    };

    glidepoint_listener: glidepoint_listener {
        compatible = "zmk,input-listener";
        device = <&glidepoint_split>;
        /* x1.5 por software sobre la ganancia 3x del sensor (su máximo
         * usable). Subir/bajar velocidad = cambiar esta fracción. */
        input-processors = <&zip_xy_scaler 3 2>;

        /* Modo precisión: con la capa Mouse (8) activa, los deltas se
         * reducen a la mitad antes del escalado base (process-next). */
        precision {
            layers = <8>;
            input-processors = <&zip_xy_scaler 1 2>;
            process-next;
        };
    };
};
